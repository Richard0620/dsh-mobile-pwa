# ============================================================================
# 缇庤タ VPS锛?8.189.61.57锛変笂鐨?Caddy 鈥斺€?DSH Mobile PWA + 鑷缓涓浆 + Web Push
#
# 涓轰粈涔堟槸 8443 涓嶆槸 443锛氳繖鍙版満鍣?443 褰?sing-box锛圴LESS Reality锛夛紝涓嶈兘鍔ㄣ€?#
# 蹇呴』鍙嶄唬鐨勪簲绫昏矾寰勶細
#   /api/*    绉诲姩 API + SSE
#   /tunnel   瀹夸富鎻掍欢鐨?WSS 闅ч亾锛堟紡浜嗗畠锛屾彙鎵嬩細鎷垮埌 200 鑰屼笉鏄?101锛?#   /push/*   鎺ㄩ€佹湇鍔★紙璁㈤槄 / 鍙戦€侊級
#   /healthz  鍋ュ悍妫€鏌?#   /status   鑺傜偣鐘舵€?# ============================================================================

{
	email admin@easymana.online
}

dsh.easymana.online:8443 {
	# ---- 绉诲姩 API / SSE ----
	handle /api/* {
		reverse_proxy 127.0.0.1:18788 {
			flush_interval -1
			transport http {
				read_timeout  24h
				write_timeout 24h
			}
		}
	}

	# ---- 瀹夸富闅ч亾锛圵ebSocket 鍗囩骇锛?---
	handle /tunnel {
		reverse_proxy 127.0.0.1:18788 {
			flush_interval -1
			transport http {
				read_timeout  24h
				write_timeout 24h
			}
		}
	}

	# ---- Web Push锛堣闃?/ 鍙戦€侊級----
	handle /push/* {
		reverse_proxy 127.0.0.1:18789 {
			transport http {
				read_timeout  30s
				write_timeout 30s
			}
		}
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:18788
	}

	handle /status {
		reverse_proxy 127.0.0.1:18788
	}

	# ---- 闈欐€?PWA ----
	# ---- 预览分支：/preview/<branch>/ 目录索引 ----
	handle_path /preview/* {
		root * /srv/dsh-preview
		try_files {path} {path}index.html
		file_server

		header {
			-Server
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
	}

	handle {
		root * /srv/dsh-mobile
		try_files {path} /index.html
		file_server

		header {
			-Server
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
	}
}
